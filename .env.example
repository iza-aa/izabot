# Local desktop agent server configuration.
HOST=127.0.0.1
PORT=4310
DATABASE_PATH=data/opendots.sqlite
# Keep OWNER_ID stable: it owns persistent conversation state.
OWNER_ID=opendots-owner
# npm run dev allows http://localhost:5173 and http://127.0.0.1:5173.
# APP_ORIGIN replaces these defaults with comma-separated exact origins.
# Include scheme, hostname and port; omit paths and trailing slashes.
# APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Required for an external HOST binding (24+ characters); enables local login too.
# OWNER_TOKEN=

# Model endpoint used by chat and scheduled runs.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# JIT scripts are owner-approval gated (/jit-review then /jit-approve).
# Set IZABOT_ENABLE_JIT=0 to remove the JIT tool from the agent prompt entirely.
# IZABOT_ENABLE_JIT=1

# Optional realtime speech.
VOICE_API_KEY=
VOICE_MODEL=
VOICE_NAME=marin

# Optional persistent computers, one per Dot, using OpenBot services.
COMPUTER_SUPERVISOR_URL=
COMPUTER_SUPERVISOR_TOKEN=
COMPUTER_TOKEN=
# Keep stable: the namespace identifies existing containers and persistent volumes.
COMPUTER_NAMESPACE=opendots
# COMPUTER_MEMORY_BYTES=2147483648
# COMPUTER_RUNTIME=runsc
# ENGINE_SOCKET=/var/run/docker.sock

# Desktop control binaries and local services (macOS).
# PERMISSIONS_PATH=data/permissions.json
# BCU_APP_PATH=
# BCU_BASE_URL=http://127.0.0.1:8765
# TAURI_BINARY_PATH=
# CUA_SPACESD_PATH=
# CUA_MCP_URL=http://127.0.0.1:3211/mcp
# PERCEPTION_BIN_PATH=
# PERCEPTION_EYE_BIN=
# APP_MEMORY_DIR=data/app-memory
# CODEX_BIN_PATH=
# CODEX_HOME=
