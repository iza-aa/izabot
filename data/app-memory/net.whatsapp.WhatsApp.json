  "states": {
    "chat_list_idle": {
      "id": "chat_list_idle",
      "description": "Layar awal WhatsApp menampilkan daftar chat di kiri tanpa obrolan aktif di kanan",
      "detection_rules": {
        "required_anchors": ["search_bar_input"],
        "forbidden_anchors": ["message_composer_box"],
        "ocr_signature_any": ["WhatsApp untuk Mac", "Terenkripsi secara end-to-end"]
      }
    },
    "search_results_open": {
      "id": "search_results_open",
      "description": "Kolom pencarian sedang fokus dan menampilkan daftar hasil filter kontak/pesan",
      "detection_rules": {
        "required_anchors": ["search_bar_input", "chat_list_first_result"],
        "focused_anchor": "search_bar_input"
      }
    },
    "conversation_open": {
      "id": "conversation_open",
      "description": "Ruang obrolan aktif terbuka di panel kanan dengan kotak input pesan siap diketik",
      "detection_rules": {
        "required_anchors": ["message_composer_box"],
        "ocr_signature_any": ["Type a message", "Ketik pesan", "Today", "Yesterday"]
      }
    }
  },
  "transitions": [
    {
      "from_state": "chat_list_idle",
      "to_state": "search_results_open",
      "action_type": "hotkey_or_click",
