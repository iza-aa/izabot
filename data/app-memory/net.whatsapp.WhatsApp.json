      "hotkey": ["Command", "f"],
      "cost": 1
    },
    {
      "from_state": "search_results_open",
      "to_state": "conversation_open",
      "action_type": "type_and_select",
      "target_anchor": "chat_list_first_result",
      "submit_key": "Return",
      "cost": 1
    },
    {
      "from_state": "conversation_open",
      "to_state": "conversation_open",
      "action_type": "type_and_submit",
      "target_anchor": "message_composer_box",
      "submit_key": "Return",
      "cost": 1
    }
  ],
  "playbooks": [
    {
      "id": "playbook_open_chat_by_contact",
      "name": "Buka Obrolan Kontak atau Grup",
      "trigger_intents": ["buka chat", "lihat pesan", "cari kontak", "tengok obrolan", "chat"],
      "parameters": ["contact_name"],
      "precondition_states": ["chat_list_idle", "conversation_open", "search_results_open"],
      "expected_final_state": "conversation_open",
      "steps": [
        {
          "step": 1,
          "op": "bcu_observe",
          "zone": "LEFT_SIDEBAR"
        },
        {
          "step": 2,
          "op": "bcu_press_key",
          "prefer_hotkey": ["Command", "f"]
        },
        {
          "step": 3,
          "op": "bcu_type_text",
          "text": "{{contact_name}}",
          "submit_with_enter": true
        },
        {
          "step": 4,
          "op": "bcu_observe",
          "expected_state": "conversation_open"
        }
      ]
    },
    {
      "id": "playbook_send_whatsapp_message",
      "name": "Kirim Pesan ke Kontak atau Grup",
      "trigger_intents": ["kirim pesan", "balas chat", "chat ke", "kabari"],
      "parameters": ["contact_name", "message_text"],
      "precondition_states": ["chat_list_idle", "conversation_open"],
      "expected_final_state": "conversation_open",
      "steps": [
        {
          "step": 1,
          "op": "bcu_type_text",
          "anchor_id": "message_composer_box",
          "text": "{{message_text}}",
          "submit_with_enter": true
        }
      ]
    }
  ],
  "reflexion_lessons": [
    "Di WhatsApp, kontak yang ada di header obrolan atas kanan adalah profil chat aktif, sedangkan untuk membuka chat baru gunakan daftar chat di sebelah kiri.",
    "Kolom pencarian WhatsApp memunculkan filter (Photos, GIFs, Links) saat fokus dalam keadaan kosong; tekan Escape untuk menutup filter tersebut setelah selesai."
  ]
}
